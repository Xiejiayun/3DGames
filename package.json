{
  "name": "3d-games",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.28",
    "playwright": "1.62.1",
    "three": "0.160.0",
    "wrangler": "4.159.0"
  },
  "scripts": {
    "test:home": "node scripts/check-homepage.mjs",
    "test:prism": "node scripts/test-prism.mjs",
    "test:ironcore": "node scripts/test-ironcore.mjs",
    "test:kart": "node scripts/kart-3d-check.mjs",
    "build": "node scripts/build-site.mjs && cf build --mode production",
    "deploy": "npm run build && cf deploy --prebuilt --mode production",
    "test": "node --test scripts/test-cs.mjs",
    "test:cs:browser": "node scripts/check-cs-browser.mjs",
    "test:flappy": "node scripts/test-flappy.mjs",
    "test:ace": "node --test --test-concurrency=1 \"scripts/test-ace*.mjs\""
  }
}
